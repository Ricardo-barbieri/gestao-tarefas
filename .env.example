# Server-only configuration. Never commit actual credentials.
ADMIN_EMAIL=
APP_ORIGIN=
# Google OAuth web client. Login and Calendar use distinct consent flows.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Services ID, Team ID, Key ID and PKCS8 private key.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 32 cryptographically random bytes encoded as base64; protects Calendar tokens.
TOKEN_ENCRYPTION_KEY=
# Legacy API/webhooks: retained, outside this revision; empty denies destinations.
WEBHOOK_ALLOWED_HOSTS=
