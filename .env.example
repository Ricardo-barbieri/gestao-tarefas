# D1 DB and R2 BUCKET are bindings configured in .openai/hosting.json.
# Hosted identity is supplied by Sites. Never enable the local mock in production.
# No external provider adapter is connected in this version.
# Future adapters must read secrets only on the server:
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# WHATSAPP_PROVIDER=
# WHATSAPP_API_KEY=
# AI_PROVIDER=
# AI_API_KEY=
# Comma-separated exact public HTTPS domains for outbound webhooks. Empty denies all.
WEBHOOK_ALLOWED_HOSTS=
